meta {
  name: 08 Create password protected
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/link/
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "url": "{{destinationUrl}}",
    "ttl_seconds": {{ttlSeconds}},
    "title": "Bruno password link",
    "policy": {
      "type": "password_protected",
      "password": "{{demoPassword}}"
    }
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("passwordUrl", res.getBody().shortened_url);
  }
}

docs {
  Creation stores a hashed password. Redirect password admission is not yet
  implemented by the API. demoPassword is a sample, not a real credential.
}
